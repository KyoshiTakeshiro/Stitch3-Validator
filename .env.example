CHUTES_API_KEY=your-chutes-key-here

# Gates /admin (HTTP Basic Auth). Leave ADMIN_PASSWORD unset to disable the
# panel entirely -- it 503s rather than falling back to a default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Raises the Engagement Value avatar daily fetch budget from 20
# (anonymous unavatar.io tier) to 50 (unavatar.io's included free quota for
# an authenticated key -- see engagement.py's _avatar_daily_budget). Only
# set this on whichever deployment should actually spend the shared daily
# quota (e.g. the production VPS) -- using the same key from a second
# environment (like local dev) competes for the same 50/day pool instead
# of getting a separate one.
UNAVATAR_API_KEY=
